# ============================================================
# RUNEBOUND — environment variables
# Copy to .env.local for `vercel dev`, or set these in the
# Vercel dashboard (Project → Settings → Environment Variables).
# ============================================================

# --- Database -------------------------------------------------
# Added automatically when you connect Neon from the Vercel
# dashboard (Storage → Neon). Only set this by hand for local dev.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# --- Sessions -------------------------------------------------
# Signs the session cookie. Generate with:  openssl rand -base64 32
# Changing it signs everyone out. Never commit the real value.
SESSION_SECRET=replace-me-with-32-random-bytes

# --- App URL --------------------------------------------------
# The canonical origin, used to build the OAuth redirect_uri.
# Set to your production domain in Vercel; use http://localhost:3000
# for `vercel dev`. If unset, it is derived from request headers.
APP_URL=http://localhost:3000

# --- OAuth: GitHub --------------------------------------------
# github.com/settings/developers → New OAuth App
# Authorization callback URL: <APP_URL>/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- OAuth: Google --------------------------------------------
# console.cloud.google.com → APIs & Services → Credentials
# → OAuth client ID → Web application
# Authorized redirect URI: <APP_URL>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Either provider may be omitted — sign-in buttons only appear
# for providers that have both an ID and a secret configured.
