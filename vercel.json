{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/runebound",
      "destination": "/runebound.html"
    },
    {
      "source": "/lifesim",
      "destination": "/lifesim.html"
    },
    {
      "source": "/adventurersguild",
      "destination": "/adventurersguild.html"
    },
    {
      "source": "/orcvillage",
      "destination": "/orcvillage.html"
    },
    {
      "source": "/((?!api/|runebound\\.html|lifesim\\.html|adventurersguild\\.html|orcvillage\\.html|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}
