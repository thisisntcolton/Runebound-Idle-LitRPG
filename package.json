    "dev:server": "node --import ./test/register.mjs test/dev-server.mjs",
    "test:pets": "node test/pets.browser.mjs",
    "test:content": "node test/content.test.mjs",
    "test:browser": "node test/regression.browser.mjs",
    "test:classes": "node test/classes.browser.mjs",
    "test:ascension": "node test/ascension.browser.mjs",
    "balance": "node test/balance.mjs",
    "preview:heroes": "node test/heroart.preview.mjs",
    "preview:pets": "node test/petart.preview.mjs",
    "sim:levels": "node test/levels.sim.mjs",
    "test:skills": "node test/skills.test.mjs",
    "test:era1": "node test/era1.browser.mjs",
    "test:era2": "node test/era2.browser.mjs",
    "test:deep": "node test/deep.browser.mjs",
    "test:townlife": "node test/townlife.browser.mjs",
    "test:boss": "node test/boss.browser.mjs",
    "test:road": "node test/road.browser.mjs",
    "sim:boss": "node test/boss.sim.mjs",
    "sim:prestige": "node test/prestige.sim.mjs",
    "sim:deep": "node test/deep.sim.mjs",
    "test:reach": "node test/reachability.test.mjs",
    "test:gaps": "node test/gaps.browser.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4"
  },
  "devDependencies": {
    "pg": "^8.23.0",
    "vite": "^5.4.0"
  }
